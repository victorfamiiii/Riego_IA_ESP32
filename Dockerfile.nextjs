# ==============================
# Stage 1: Dependencias
# ==============================
FROM node:20-alpine AS deps
WORKDIR /app

# Copiar archivos de dependencias
COPY frontend-nextjs/package*.json ./

# Instalar TODAS las dependencias (incluidas devDependencies para build)
RUN npm ci

# ==============================
# Stage 2: Builder
# ==============================
FROM node:20-alpine AS builder
WORKDIR /app

# Firebase Cloud Messaging (FCM) build arguments
ARG NEXT_PUBLIC_FIREBASE_API_KEY
ARG NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=riego-esp32-fcm.firebaseapp.com
ARG NEXT_PUBLIC_FIREBASE_PROJECT_ID=riego-esp32-fcm
ARG NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=riego-esp32-fcm.firebasestorage.app
ARG NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=629937244404
ARG NEXT_PUBLIC_FIREBASE_APP_ID

# Push Notifications VAPID key argument
ARG NEXT_PUBLIC_VAPID_PUBLIC_KEY

# Convert ARGs to ENVs so Next.js captures them during build
ENV NEXT_PUBLIC_FIREBASE_API_KEY=$NEXT_PUBLIC_FIREBASE_API_KEY
ENV NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=$NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN
ENV NEXT_PUBLIC_FIREBASE_PROJECT_ID=$NEXT_PUBLIC_FIREBASE_PROJECT_ID
ENV NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=$NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET
ENV NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=$NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID
ENV NEXT_PUBLIC_FIREBASE_APP_ID=$NEXT_PUBLIC_FIREBASE_APP_ID
ENV NEXT_PUBLIC_VAPID_PUBLIC_KEY=$NEXT_PUBLIC_VAPID_PUBLIC_KEY

# Copiar node_modules desde stage deps
COPY --from=deps /app/node_modules ./node_modules

# Copiar código fuente
COPY frontend-nextjs/ ./

# Configurar variables de entorno para build
ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_ENV=production

# Construir aplicación
RUN npm run build

# ==============================
# Stage 3: Runner
# ==============================
FROM node:20-alpine AS runner
WORKDIR /app

# Configurar entorno de producción
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

# Crear usuario no-root
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs

# Copiar archivos públicos
COPY --from=builder /app/public ./public

# Configurar permisos para caché de Next.js
RUN mkdir .next && chown nextjs:nodejs .next

# Copiar archivos de producción con permisos correctos
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static
COPY --from=builder --chown=nextjs:nodejs /app/public ./public

# Cambiar a usuario no-root
USER nextjs

# Exponer puerto
EXPOSE 3000

# Health check - verifica que Next.js responda (usando 127.0.0.1 ya que está dentro del contenedor)
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=5 \
  CMD node -e "require('http').get({host:'127.0.0.1',port:3000,path:'/app',timeout:3000}, (r) => {process.exit(r.statusCode < 500 ? 0 : 1)}).on('error', () => process.exit(1))"

# Comando de inicio
CMD ["node", "server.js"]
